    "id": "song-amazing-grace",
    "title": "Amazing Grace",
    "verses": [
      { "id": "v1", "lines": ["Amazing grace! how sweet the sound", "That saved a wretch like me;", "I once was lost, but now am found,", "Was blind, but now I see."] },
      { "id": "v2", "lines": ["'Twas grace that taught my heart to fear,", "And grace my fears relieved;", "How precious did that grace appear", "The hour I first believed."] }
